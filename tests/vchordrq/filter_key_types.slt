# Filter keys of every type, with infinities, NaN, negative zero, cross-type constants and NULLs.

statement ok
CREATE TYPE ft_mood AS ENUM ('sad', 'ok', 'happy');

statement ok
CREATE TABLE ft (id int PRIMARY KEY, d date, ts timestamp, tz timestamptz, o oid, b bool, f4 float4, f8 float8,
  m ft_mood, v vector(3));

statement ok
INSERT INTO ft SELECT i,
  CASE WHEN i % 97 = 0 THEN NULL WHEN i % 89 = 0 THEN '-infinity' WHEN i % 83 = 0 THEN 'infinity'
    WHEN i % 181 = 0 THEN '300000-01-01' WHEN i % 191 = 0 THEN '4714-11-24 BC' ELSE date '2000-01-01' + (i * 37) % 9000 - 4000 END,
  CASE WHEN i % 101 = 0 THEN NULL WHEN i % 79 = 0 THEN 'infinity' WHEN i % 199 = 0 THEN '-infinity'
    ELSE timestamp '2010-06-01' + ((i * 7919) % 100000 - 50000) * interval '37 minutes' END,
  CASE WHEN i % 103 = 0 THEN NULL WHEN i % 73 = 0 THEN '-infinity' WHEN i % 193 = 0 THEN 'infinity'
    ELSE timestamptz '2010-06-01 00:00+00' + ((i * 104729) % 100000 - 50000) * interval '29 minutes' END,
  CASE WHEN i % 107 = 0 THEN NULL ELSE ((i * 2654435761) % 4294967296)::int8::oid END,
  CASE WHEN i % 109 = 0 THEN NULL ELSE i % 3 = 0 END,
  CASE WHEN i % 113 = 0 THEN NULL WHEN i % 71 = 0 THEN 'NaN' WHEN i % 67 = 0 THEN '-0' WHEN i % 61 = 0 THEN '-infinity'
    ELSE (sin(i) * 1000)::float4 END,
  CASE WHEN i % 127 = 0 THEN NULL WHEN i % 59 = 0 THEN 'NaN' WHEN i % 53 = 0 THEN 'infinity'
    ELSE cos(i) * 1e6 END,
  CASE WHEN i % 131 = 0 THEN NULL ELSE (ARRAY['sad', 'ok', 'happy']::ft_mood[])[1 + i % 3] END,
  ARRAY[sin(i), cos(1.3 * i), sin(0.7 * i)]::real[]::vector
FROM generate_series(1, 6000) i;

statement ok
CREATE INDEX ft_v ON ft USING vchordrq (v vector_l2_ops, d, ts, tz, o, b, f4, f8, m) WITH (options = $$
residual_quantization = true
zone_maps = 8
[build.internal]
lists = [4]
$$);

statement ok
SET enable_seqscan = off;

statement ok
SET enable_sort = off;

statement ok
SET vchordrq.probes = '4';

statement ok
CREATE FUNCTION ft_same(cond text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE a int[]; b int[];
BEGIN
  EXECUTE format('SELECT array_agg(id ORDER BY id) FROM (SELECT id FROM ft WHERE %s '
    'ORDER BY v <-> ''[0.5,0.5,0.5]'') s', cond) INTO a;
  EXECUTE format('SELECT array_agg(id ORDER BY id) FROM ft WHERE (%s) IS TRUE', cond) INTO b;
  RETURN a IS NOT DISTINCT FROM b;
END
$$;

statement ok
CREATE FUNCTION ft_check() RETURNS text LANGUAGE sql AS $$
  SELECT coalesce(string_agg(c, '; '), 'all equal') FROM unnest(ARRAY[
    'd < ''2000-01-01''', 'd >= ''2005-03-04''', 'd = ''-infinity''', 'd > ''infinity''', 'd < ''infinity''',
    'd BETWEEN ''1995-01-01'' AND ''1996-01-01''', 'd IS NULL',
    'd < ''2001-01-01 12:00''::timestamp', 'd <= ''2001-01-01 00:00''::timestamp', 'd = ''2001-01-01 00:00''::timestamp',
    'd > ''2001-01-01 12:00''::timestamp', 'd = ''2001-01-01 12:00''::timestamp', 'd >= ''infinity''::timestamp',
    'd < ''2001-01-01 12:00+05''::timestamptz', 'd > ''1999-12-31 23:00-03''::timestamptz',
    'ts < ''2010-06-01''', 'ts > ''2011-01-01 13:37''', 'ts = ''infinity''', 'ts IS NOT NULL AND ts < ''2009-01-01''',
    'ts > ''300000-01-01''::date', 'ts = ''300000-01-01''::date', 'ts <= ''300000-01-01''::date',
    'ts >= ''294277-01-05''::date', 'ts < ''294277-01-10''::date', 'ts BETWEEN ''2010-06-01'' AND ''300000-01-01''::date',
    'ts <= ''4714-11-24 BC''::date', 'ts < ''4714-11-24 BC''::date', 'ts > ''4714-11-24 BC''::date',
    'tz > ''300000-01-01''::date', 'tz <= ''300000-01-01''::date', 'tz < ''4714-11-24 BC''::date',
    'd > ''294276-12-31 23:59:59''::timestamp', 'd >= ''4714-11-24 00:00 BC''::timestamp', 'd <= ''-infinity''::timestamp',
    'ts < ''2010-06-02''::date', 'ts >= ''2010-06-02''::date', 'ts = ''infinity''::date',
    'ts < ''2010-06-01 00:00+02''::timestamptz', 'ts >= ''2010-06-01 00:00-11''::timestamptz',
    'tz < ''2010-06-01 00:00+00''', 'tz > ''2010-07-01 03:00+05''', 'tz = ''-infinity''', 'tz <= ''-infinity''',
    'tz < ''2010-06-02''::date', 'tz >= ''2010-05-02 05:00''::timestamp', 'tz < ''infinity''::date',
    'o < 1000000000', 'o > 3000000000', 'o BETWEEN 0 AND 4294967295', 'o = 2654435761',
    'b', 'NOT b', 'b = true', 'b < true', 'b IS NULL',
    'f4 < 0', 'f4 = 0', 'f4 = ''-0''', 'f4 > 500', 'f4 = ''NaN''', 'f4 < ''NaN''', 'f4 >= ''NaN''', 'f4 = ''-infinity''',
    'f4 < 0.1::float8', 'f4 >= 0.1::float8', 'f4 = 0.1::float8', 'f4 > 1e300::float8', 'f4 < -1e300::float8',
    'f4 = ''NaN''::float8', 'f4 > 841.47096::float8',
    'f8 > 0', 'f8 = ''infinity''', 'f8 >= ''NaN''', 'f8 < 0.1::float4', 'f8 = ''-0''::float4',
    'm = ''ok''', 'm = ANY(''{sad,happy}'')', 'm IS NULL',
    'd > ''2001-01-01'' AND ts < ''2010-06-01'' AND f4 > 0 AND m = ''sad'''
  ]) c WHERE NOT ft_same(c)
$$;

query T
SELECT ft_check();
----
all equal

statement ok
SET TimeZone = 'Pacific/Kiritimati';

query T
SELECT ft_check();
----
all equal

statement ok
SET TimeZone = 'America/St_Johns';

query T
SELECT ft_check();

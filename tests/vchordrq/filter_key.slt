  CROSS JOIN LATERAL (SELECT id FROM fk WHERE fk.owner = o.owner ORDER BY v <-> '[0.5,0.5,0.5]') s)
  = (SELECT array_agg(id ORDER BY id) FROM fk WHERE owner IN ('00000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-000000000002'));

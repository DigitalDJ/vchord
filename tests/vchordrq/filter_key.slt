# A filter key column: `USING vchordrq (v ..., owner)`. Equality and `= ANY`
# quals on the second key column are scan keys answered by a 16-bit tag in
# every index row; the executor rechecks them, so a tag collision costs work,
# never a row. Most checks compare the index scan's full stream (all lists
# probed, no LIMIT, so ties cannot move rows across a cut) as a set against the
# heap; the others compare the distances of a top 10 with an exact search. On PostgreSQL 14-16 the planner keeps `= ANY` on a second index column
# out of ordered scans, so there it stays a Filter: correct, not filtered.

statement ok
CREATE TABLE fk (id int PRIMARY KEY, owner uuid, grp int4, note text, v vector(3));

statement ok
INSERT INTO fk SELECT i,
  CASE WHEN i % 100 = 0 THEN NULL
       ELSE ('00000000-0000-0000-0000-' || lpad((i % 10)::text, 12, '0'))::uuid END,
  i % 7, NULL,
  ARRAY[(i % 97) / 97.0, (i % 89) / 89.0, (i % 83) / 83.0]::real[]::vector
FROM generate_series(1, 30000) i;

# more filter key columns (`filter_keys.slt`)
statement ok
CREATE INDEX fk_two ON fk USING vchordrq (v vector_l2_ops, owner, grp);

statement ok
DROP INDEX fk_two;

# the vector column comes first
statement error Dimensions type modifier of a vector column is needed
CREATE INDEX ON fk USING vchordrq (owner, v vector_l2_ops);

statement error has no default operator class for access method
CREATE INDEX ON fk USING vchordrq (v vector_l2_ops, note);

statement ok
CREATE TABLE fk_maxsim (owner uuid, v vector(3)[]);

statement error filter key column with a maxsim operator class is not supported
CREATE INDEX ON fk_maxsim USING vchordrq (v vector_maxsim_ops, owner);

statement ok
DROP TABLE fk_maxsim;

statement error does not support included columns
CREATE INDEX ON fk USING vchordrq (v vector_l2_ops) INCLUDE (owner);

statement error unknown operator class of a filter key column
CREATE INDEX ON fk USING vchordrq (v vector_l2_ops, v vector_ip_ops);

# a parallel build
statement ok
SET max_parallel_maintenance_workers = 2;

statement ok
ALTER TABLE fk SET (parallel_workers = 2);

statement ok
CREATE INDEX fk_v ON fk USING vchordrq (v vector_l2_ops, owner) WITH (options = $$
residual_quantization = true
[build.internal]
lists = [32]
$$);

statement ok
RESET max_parallel_maintenance_workers;

statement ok
ALTER TABLE fk RESET (parallel_workers);

query T
SELECT pg_get_indexdef('fk_v'::regclass) LIKE '%USING vchordrq (v vector_l2_ops, owner)%';
----
t

# the index depends on both key columns' operator classes
query I
SELECT count(*) FROM pg_depend WHERE classid = 'pg_class'::regclass AND objid = 'fk_v'::regclass
  AND refclassid = 'pg_opclass'::regclass;
----
2

statement ok
SET enable_seqscan = off;

statement ok
SET enable_sort = off;

statement ok
SET vchordrq.probes = '32';

# filtered stream (index) == heap rows satisfying the condition
statement ok
CREATE FUNCTION fk_same(cond text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE a int[]; b int[];
BEGIN
  EXECUTE format('SELECT array_agg(id ORDER BY id) FROM (SELECT id FROM fk WHERE %s '
    'ORDER BY v <-> ''[0.5,0.5,0.5]'') s', cond) INTO a;
  EXECUTE format('SELECT array_agg(id ORDER BY id) FROM fk WHERE (%s) IS TRUE', cond) INTO b;
  RETURN a IS NOT DISTINCT FROM b;
END
$$;

statement ok
CREATE FUNCTION fk_plan(q text, with_analyze boolean DEFAULT false) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r text; result text := '';
BEGIN
  FOR r IN EXECUTE 'EXPLAIN (COSTS OFF' ||
    CASE WHEN with_analyze THEN ', ANALYZE, TIMING OFF, SUMMARY OFF' ELSE '' END || ') ' || q LOOP
    result := result || r || E'\n';
  END LOOP;
  RETURN result;
END
$$;

query T
SELECT fk_same('owner = ''00000000-0000-0000-0000-000000000001''');
----
t

query T
SELECT fk_same('''00000000-0000-0000-0000-000000000001'' = owner');
----
t


# the top 10 at full probes: the same distances as an exact search
statement ok
CREATE FUNCTION fk_top(cond text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE a real[]; b real[];
BEGIN
  EXECUTE format('SELECT array_agg(d) FROM (SELECT v <-> ''[0.3,0.6,0.2]'' AS d FROM fk WHERE %s '
    'ORDER BY v <-> ''[0.3,0.6,0.2]'' LIMIT 10) s', cond) INTO a;
  -- no index can produce this order
  EXECUTE format('SELECT array_agg(d) FROM (SELECT v <-> ''[0.3,0.6,0.2]'' AS d FROM fk WHERE %s '
    'ORDER BY (v <-> ''[0.3,0.6,0.2]'') + 0 LIMIT 10) s', cond) INTO b;
  RETURN a = b;
END
$$;

query T
SELECT fk_top('true');
----
t

# and the same as filtering above an unfiltered scan of the same index
statement ok
CREATE FUNCTION fk_above(cond text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE a real[]; b real[];
BEGIN
  EXECUTE format('SELECT array_agg(d) FROM (SELECT v <-> ''[0.3,0.6,0.2]'' AS d FROM fk WHERE %s '
    'ORDER BY v <-> ''[0.3,0.6,0.2]'' LIMIT 10) s', cond) INTO a;
  EXECUTE format('SELECT array_agg(d) FROM (SELECT d FROM (SELECT fk.*, v <-> ''[0.3,0.6,0.2]'' AS d FROM fk '
    'ORDER BY v <-> ''[0.3,0.6,0.2]'' OFFSET 0) u WHERE %s LIMIT 10) s', cond) INTO b;
  RETURN a = b;
END
$$;


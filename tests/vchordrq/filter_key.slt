# generic plan: the key is a run-time key
statement ok
PREPARE fkp(uuid[]) AS SELECT
  (SELECT array_agg(id ORDER BY id) FROM (SELECT id FROM fk WHERE owner = ANY($1) ORDER BY v <-> '[0.5,0.5,0.5]') s)
  = (SELECT array_agg(id ORDER BY id) FROM fk WHERE owner = ANY($1));

statement ok

  CROSS JOIN LATERAL (SELECT id FROM fk WHERE fk.owner = o.owner ORDER BY v <-> ''[0.5,0.5,0.5]'' LIMIT 20) s') LIKE '%Nested Loop%Index Scan using fk_v%Index Cond: (owner = %';
